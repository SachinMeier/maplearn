{
  "name": "maplearn",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/offline-manifest.mjs",
    "dev": "python3 -m http.server 4173 --bind 127.0.0.1",
    "build": "node scripts/build.mjs",
    "preview": "python3 -m http.server 4174 --bind 127.0.0.1 --directory dist",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "placeholder": "node scripts/generate-placeholder.mjs",
    "maps:generate": "node scripts/generate-world.mjs && node scripts/generate-regions.mjs",
    "maps:regions": "node scripts/generate-regions.mjs",
    "maps:thumbnails": "node scripts/generate-thumbnails.mjs",
    "maps:us-nyc": "node scripts/generate-us-nyc.mjs",
    "maps:water": "node scripts/generate-water.mjs",
    "maps:rivers": "node scripts/generate-europe-rivers.mjs",
    "maps:france": "node scripts/generate-france.mjs",
    "maps:massachusetts": "node scripts/generate-massachusetts.mjs",
    "maps:india": "node scripts/generate-india.mjs",
    "maps:china": "node scripts/generate-china.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "polygon-clipping": "0.15.7",
    "polylabel": "2.0.1",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1"
  }
}
